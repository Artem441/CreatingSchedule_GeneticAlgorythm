<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CreatingSchedule.ViewModels"
        x:Class="CreatingSchedule.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1080" Height="700"
        Background="#1E1E1E" Foreground="White"
        Title="Генератор расписания">

    <Window.Styles>
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button">
            <Setter Property="Background" Value="#2A2A3C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="8"/>
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="Background" Value="#2A2A3C"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="TextBox">
            <Setter Property="Background" Value="#2A2A3C"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </Window.Styles>

    <!-- Главная сетка -->
    <Grid ColumnDefinitions="300,*">
        
        <!-- Левая панель -->
        <ScrollViewer Grid.Column="0" Margin="15">
            <StackPanel Spacing="10">
                <TextBlock Text="Параметры алгоритма" FontSize="20" FontWeight="Bold" />
                
                <TextBlock Text="Популяция:" />
                <NumericUpDown Minimum="10" Maximum="1000" Value="{Binding PopulationSize}" />

                <TextBlock Text="Поколения:" />
                <NumericUpDown Minimum="100" Maximum="5000" Value="{Binding Generations}" />

                <TextBlock Text="Мутации:" />
                <Slider Minimum="0.0" Maximum="1.0" Value="{Binding MutationRate}" TickFrequency="0.05" />

                <Button Content="Генерировать" Command="{Binding GenerateScheduleCommand}" />
                <Button Content="Сброс" Command="{Binding ResetCommand}" />

                <TextBlock Text="Добавление преподавателя / предмета" FontSize="16" Margin="0,20,0,5" />
                <TextBox Watermark="ФИО преподавателя" Text="{Binding NewTeacherName}" />
                <TextBox Watermark="Предмет" Text="{Binding NewSubjectName}" />
                <Button Content="Добавить" Command="{Binding AddTeacherSubjectCommand}" />

                <TextBlock Text="Добавление аудитории" FontSize="16" Margin="0,20,0,5" />
                <TextBox Watermark="Номер аудитории" Text="{Binding NewClassroomName}" />
                <Button Content="Добавить" Command="{Binding AddClassroomCommand}" />
            </StackPanel>
        </ScrollViewer>

        <!-- Правая панель -->
        <ScrollViewer Grid.Column="1" Margin="15">
            <StackPanel Spacing="10">
                <TextBlock Text="Расписание" FontSize="20" FontWeight="Bold" />
                <ComboBox ItemsSource="{Binding GroupNames}" SelectedItem="{Binding SelectedGroup}" />

                <!-- Табличное расписание -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Заголовки дней -->
                    <TextBlock Grid.Row="0" Grid.Column="0" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="Пн" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Вт" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Row="0" Grid.Column="3" Text="Ср" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Row="0" Grid.Column="4" Text="Чт" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Row="0" Grid.Column="5" Text="Пт" HorizontalAlignment="Center"/>

                    <!-- Строки по слотам -->
                    <ItemsControl Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="6" 
                                  ItemsSource="{Binding TimeSlotSchedules}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Время пары -->
                                    <TextBlock Grid.Column="0" Text="{Binding TimeTable}" VerticalAlignment="Top" Margin="4" />

                                    <!-- Занятия в день/слот -->
                                    <ItemsControl Grid.Column="1" ItemsSource="{Binding Monday}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#2A2A3C" Margin="2" Padding="4" CornerRadius="4">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Subject.Name}" FontWeight="Bold"/>
                                                        <TextBlock Text="{Binding Teacher.Name}" FontStyle="Italic"/>
                                                        <TextBlock Text="{Binding Classroom.Name}"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <ItemsControl Grid.Column="2" ItemsSource="{Binding Tuesday}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#2A2A3C" Margin="2" Padding="4" CornerRadius="4">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Subject.Name}" FontWeight="Bold"/>
                                                        <TextBlock Text="{Binding Teacher.Name}" FontStyle="Italic"/>
                                                        <TextBlock Text="{Binding Classroom.Name}"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <ItemsControl Grid.Column="3" ItemsSource="{Binding Wednesday}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#2A2A3C" Margin="2" Padding="4" CornerRadius="4">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Subject.Name}" FontWeight="Bold"/>
                                                        <TextBlock Text="{Binding Teacher.Name}" FontStyle="Italic"/>
                                                        <TextBlock Text="{Binding Classroom.Name}"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <ItemsControl Grid.Column="4" ItemsSource="{Binding Thursday}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#2A2A3C" Margin="2" Padding="4" CornerRadius="4">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Subject.Name}" FontWeight="Bold"/>
                                                        <TextBlock Text="{Binding Teacher.Name}" FontStyle="Italic"/>
                                                        <TextBlock Text="{Binding Classroom.Name}"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <ItemsControl Grid.Column="5" ItemsSource="{Binding Friday}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#2A2A3C" Margin="2" Padding="4" CornerRadius="4">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Subject.Name}" FontWeight="Bold"/>
                                                        <TextBlock Text="{Binding Teacher.Name}" FontStyle="Italic"/>
                                                        <TextBlock Text="{Binding Classroom.Name}"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>


