<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CreatingSchedule.ViewModels"
        x:Class="CreatingSchedule.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1080" Height="700"
        Background="#1E1E1E" Foreground="White"
        Title="Генератор расписания">

    <Window.Styles>
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button">
            <Setter Property="Background" Value="#2A2A3C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="8"/>
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="Background" Value="#2A2A3C"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="TextBox">
            <Setter Property="Background" Value="#2A2A3C"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </Window.Styles>

    <!-- Главная сетка -->
    <Grid ColumnDefinitions="300,*">
        
        <!-- Левая панель -->
        <ScrollViewer Grid.Column="0" Margin="15">
            <StackPanel Spacing="10">
                <TextBlock Text="Параметры алгоритма" FontSize="20" FontWeight="Bold" />
                
                <TextBlock Text="Популяция:" />
                <NumericUpDown Minimum="10" Maximum="1000" Value="{Binding PopulationSize}" />

                <TextBlock Text="Поколения:" />
                <NumericUpDown Minimum="100" Maximum="5000" Value="{Binding Generations}" />

                <TextBlock Text="Мутации:" />
                <Slider Minimum="0.0" Maximum="1.0" Value="{Binding MutationRate}" TickFrequency="0.05" />

                <Button Content="Генерировать" Command="{Binding GenerateScheduleCommand}" />
                <Button Content="Сброс" Command="{Binding ResetCommand}" />

                <TextBlock Text="Добавление преподавателя / предмета" FontSize="16" Margin="0,20,0,5" />
                <TextBox Watermark="ФИО преподавателя" Text="{Binding NewTeacherName}" />
                <TextBox Watermark="Предмет" Text="{Binding NewSubjectName}" />
                <Button Content="Добавить" Command="{Binding AddTeacherSubjectCommand}" />

                <TextBlock Text="Добавление аудитории" FontSize="16" Margin="0,20,0,5" />
                <TextBox Watermark="Номер аудитории" Text="{Binding NewClassroomName}" />
                <Button Content="Добавить" Command="{Binding AddClassroomCommand}" />
            </StackPanel>
        </ScrollViewer>

        <!-- Правая панель -->
        <ScrollViewer Grid.Column="1" Margin="15">
            <StackPanel Spacing="10">
                <TextBlock Text="Расписание" FontSize="20" FontWeight="Bold" />
                <ComboBox ItemsSource="{Binding GroupNames}" SelectedItem="{Binding SelectedGroup}" />

                <!-- Таблица расписания (Grid, т.к. DataGrid глючит) -->
                <ItemsControl ItemsSource="{Binding ScheduleForSelectedGroup}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#2A2A3C" Margin="0,5" Padding="6" CornerRadius="4">
                                <Grid ColumnDefinitions="*,*,*,*,*">
                                    <TextBlock Grid.Column="0" Text="{Binding Subject.Name}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Teacher.Name}" />
                                    <TextBlock Grid.Column="2" Text="{Binding Classroom.Name}" />
                                    <TextBlock Grid.Column="3" Text="{Binding DayOfWeek}" />
                                    <TextBlock Grid.Column="4" Text="{Binding TimeSlot}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>


